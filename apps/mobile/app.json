{
  "expo": {
    "name": "Talk후감",
    "slug": "talkhugam",
    "scheme": "talkhugam",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.talkhugam",
      "associatedDomains": [
        "applinks:talkhugam.vercel.app"
      ]
    },
    "android": {
      "package": "app.talkhugam",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "talkhugam.vercel.app",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "talkhugam.vercel.app",
              "pathPrefix": "/rooms"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-image-picker", {
        "cameraPermission": "독서 순간 영상을 촬영하려면 카메라 접근이 필요합니다.",
        "photosPermission": "독서 순간 영상을 선택하려면 사진 보관함 접근이 필요합니다."
      }],
      "expo-video",
      "expo-notifications"
    ]
  }
}
