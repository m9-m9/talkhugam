{
  "expo": {
    "name": "Talk후감",
    "slug": "talkhugam",
    "scheme": "talkhugam",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.talkhugam",
      "associatedDomains": [
        "applinks:talkhugam.vercel.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.talkhugam",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "talkhugam.vercel.app",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "https",
              "host": "talkhugam.vercel.app",
              "pathPrefix": "/rooms"
            },
            {
              "scheme": "https",
              "host": "talkhugam.vercel.app",
              "pathPrefix": "/community"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "독서 순간 영상을 촬영하거나 책 페이지를 찍어 문장을 가져오려면 카메라 접근이 필요합니다.",
          "photosPermission": "독서 순간 영상이나 문장을 가져올 책 페이지 사진을 고르려면 사진 보관함 접근이 필요합니다."
        }
      ],
      "expo-video",
      "expo-notifications",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df9281eb-d568-434a-a7a7-a3b8ea5feb64"
      }
    },
    "owner": "facilance",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/df9281eb-d568-434a-a7a7-a3b8ea5feb64"
    }
  }
}
